# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=mock-or-real-key
PLAN_MODE=fixture

# Target Application
API_BASE_URL=http://localhost:8001
WEB_BASE_URL=http://localhost:3000
ALLOWED_TARGET_HOSTS=localhost,127.0.0.1,demo-api,demo-web

# Test Credentials
TEST_USER_EMAIL=tester@example.test
TEST_USER_PASSWORD=SecretPassword123!

# Execution Settings
TEST_TIMEOUT_MS=15000
MAX_RETRIES=2
MAX_TESTS_PER_RUN=10
BROWSER_HEADLESS=true
OUTPUT_DIR=output
TARGET_ENVIRONMENT=staging

# Demo Bug Switch
DEMO_BUG_MODE=
